hath0r:AgentRole a owl:Class .

hath0r:Rule a owl:Class .

<https://hath0r.dev/ontology/v1#role:developer> a hath0r:AgentRole ;
    rdfs:label "Developer Agent" ;
    hath0r:inPlane "rules" .

hath0r:Plane a owl:Class .

